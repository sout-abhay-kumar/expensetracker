{
  "info": {
    "_postman_id": "8b1b7e36-2b74-4c57-98a8-4f8c6d8e1001",
    "name": "ExpenseTracker API",
    "description": "Generated from the project's uploaded OpenAPI 3.1 specification. Import this collection and the included local environment. Start with Google Login, then Get Categories, then test transactions and budgets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/google",
            "description": "Paste a fresh Google Identity Services ID token into google_id_token. A successful response saves access_token automatically.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"{{google_id_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Login successful', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.access_token) pm.environment.set('access_token', data.access_token);",
                  "if (data.user?.id) pm.environment.set('user_id', data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/me",
            "description": "Requires the Bearer token saved by Google Login."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Current user returned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Transactions",
      "item": [
        {
          "name": "List Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/transactions",
            "description": "Lists transactions belonging to the authenticated user."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Returns an array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List Transactions - Filter by Month",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/transactions?month={{month}}&year={{year}}",
            "description": "Optional month/year filters."
          },
          "response": []
        },
        {
          "name": "Create Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/transactions",
            "description": "Use an existing category ID. Run Get Categories first and update category_id if needed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lunch\",\n  \"amount\": 250,\n  \"kind\": \"expense\",\n  \"category_id\": {{category_id}},\n  \"transaction_date\": \"{{transaction_date}}\",\n  \"note\": \"Postman test transaction\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Transaction created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.id) pm.environment.set('transaction_id', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Transaction",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/transactions/{{transaction_id}}",
            "description": "Uses transaction_id saved by Create Transaction. The API requires the complete TransactionCreate body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lunch - Updated\",\n  \"amount\": 300,\n  \"kind\": \"expense\",\n  \"category_id\": {{category_id}},\n  \"transaction_date\": \"{{transaction_date}}\",\n  \"note\": \"Updated from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Transaction updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/transactions/{{transaction_id}}",
            "description": "Deletes the transaction created earlier."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Transaction deleted', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
