              }
            ],
            "url": "{{base_url}}/api/budgets",
            "description": "Upserts a budget for the selected category and month. Use an existing category ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{category_id}},\n  \"amount\": 5000,\n  \"month\": {{month}},\n  \"year\": {{year}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Budget saved', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
